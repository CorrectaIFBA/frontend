# Where the Vite dev proxy forwards /api/identity, /api/cohort, /api/assessment,
# /api/workspace and /api/evaluation (development only). This is the local gateway
# proxy (local/run proxy). It strips the /api/<module> prefix, authenticates the
# request where needed, adds the X-User-* headers and forwards to core-service.
CORE_SERVICE_PROXY_TARGET=http://localhost:8080

# Base URL the browser uses to reach the identity module.
VITE_IDENTITY_API_URL=/api/identity

# Base URL the browser uses to reach the cohort module's API.
VITE_COHORT_API_URL=/api/cohort/api/v1

# Base URL the browser uses to reach the assessment module's API.
VITE_ASSESSMENT_API_URL=/api/assessment/api/v1

# Base URL the browser uses to reach the workspace module (drafts and submissions).
VITE_WORKSPACE_API_URL=/api/workspace

# Base URL the browser uses to reach the evaluation module (run results over WebSocket).
# Must be on the page's own host: the socket authenticates with a cookie set for this path.
VITE_EVALUATION_API_URL=/api/evaluation
